[commit]
	gpgSign = false
[gui]
	pruneduringfetch = true
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true
[push]
	recurseSubmodules = check
[gc]
	autoDetach = false
[pull]
	rebase = false
[credential]
	helper = osxkeychain
