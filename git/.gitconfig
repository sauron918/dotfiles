[includeIf "gitdir:~/nc/"]
    path = ~/.config/git/.gitconfig.work
[includeIf "gitdir:~/sp/"]
    path = ~/.config/git/.gitconfig.work
[includeIf "gitdir:~/dev/"]
    path = ~/.config/git/.gitconfig.personal
[commit]
	gpgSign = false
[gui]
	pruneduringfetch = true
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true
[push]
	recurseSubmodules = check
[gc]
	autoDetach = false
[pull]
	rebase = false
[credential]
	helper = osxkeychain
